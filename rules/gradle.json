{
  "id": "gradle",
  "name": "Android, Kotlin and Java (Gradle)",
  "detect": ["build.gradle", "build.gradle.kts", "settings.gradle", "settings.gradle.kts"],
  "outputs": [
    { "path": "build", "requireAny": ["intermediates", "outputs", "tmp", "generated", "kotlin", "reports", "classes", "libs", "test-results"] },
    { "path": ".gradle", "requireAny": ["buildOutputCleanup", "file-system.probe", "checksums", "vcs-1"] },
    { "path": ".cxx", "requireAny": ["Debug", "Release", "RelWithDebInfo", "MinSizeRel"] }
  ],
  "wake": [
    { "when": "gradlew", "run": "./gradlew help", "windows": "gradlew.bat help" },
    { "run": "gradle help" }
  ]
}
