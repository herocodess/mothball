// Cloudflare hosting for usemothball.dev: static files only, no server code.
// Deployed by Cloudflare's Git integration with root directory "site".
{
  "name": "mothball-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
